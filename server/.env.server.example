# Low-cost single-server deployment settings.
# Copy this file to server/.env.server on the server and edit the values.

PORT=3000
PUBLIC_API_PORT=3000
WEB_CONCURRENCY=2

# Use http://server-ip:3000 first. Change to https://your-domain after adding
# a reverse proxy and HTTPS.
PUBLIC_BASE_URL=http://your-server-ip:3000

# PostgreSQL runs in the same docker-compose stack.
POSTGRES_DB=drama_highlight
POSTGRES_USER=drama
POSTGRES_PASSWORD=change-this-strong-password

# Host path on the server that contains drama folders and videos.
DRAMA_HOST_PATH=/opt/drama-highlight/drama

# Optional model settings. Leave empty if you only need existing manifests and
# interaction persistence.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_AUDIO_NAME=
MODEL_TIMEOUT=120
