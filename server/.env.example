# Chat model used to convert timestamped transcripts into highlight manifests.
# For OpenAI, MODEL_BASE_URL can be omitted.
MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_API_KEY=replace-me
MODEL_NAME=doubao-seed-2-0-lite-260428

# Optional model used by the Responses API audio-understanding fallback.
# Defaults to MODEL_NAME when omitted.
MODEL_AUDIO_NAME=doubao-seed-2-0-lite-260428

# Optional dedicated speech-to-text endpoint.
# If ASR_MODEL is omitted, the pipeline falls back to the Responses API audio
# understanding path using MODEL_API_KEY and MODEL_AUDIO_NAME.
ASR_BASE_URL=https://your-audio-transcription-endpoint/v1
ASR_API_KEY=replace-me
ASR_MODEL=whisper-1

# Optional local tool paths when ffmpeg and ffprobe are not on PATH.
FFMPEG_PATH=C:\path\to\ffmpeg.exe
FFPROBE_PATH=C:\path\to\ffprobe.exe
