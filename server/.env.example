# Chat model used to convert timestamped transcripts into highlight manifests.
# For OpenAI, MODEL_BASE_URL can be omitted.
MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_API_KEY=replace-me
MODEL_NAME=doubao-seed-2-0-lite-260428

# Per-request timeout (seconds) for chat completions. Defaults to 120.
# MODEL_TIMEOUT=120

# PostgreSQL persistence. Runtime defaults to this local development URL.
DATABASE_URL=postgresql+psycopg://drama:drama_dev@localhost:5432/drama_highlight

# Optional: keep only for tests or temporary local fallback.
# STORE_BACKEND=memory

# Model used to transcribe audio via the model API (default ASR path).
# Defaults to MODEL_NAME when omitted.
MODEL_AUDIO_NAME=doubao-seed-2-0-lite-260428

# --- ASR ---
# Default: transcribe via the model API (MODEL_AUDIO_NAME above). Leave ASR_ENGINE
# unset — no local model required.
#
# Optional A: a dedicated remote STT endpoint. Set ASR_MODEL to the STT model name.
# ASR_BASE_URL=https://your-audio-transcription-endpoint/v1
# ASR_API_KEY=replace-me
# ASR_MODEL=whisper-1
#
# Optional B: local offline whisper. Requires `pip install openai-whisper torch`.
# WHISPER_MODEL is the size: tiny, base, small, medium, large, or large-v3.
# ASR_ENGINE=whisper
# WHISPER_MODEL=small
# ASR_LANGUAGE=zh
# ASR_DEVICE=auto

# Optional local tool paths when ffmpeg and ffprobe are not on PATH.
# Leave these commented out to use ffmpeg/ffprobe from PATH. Only uncomment and
# set real paths when the tools are not on PATH, otherwise an invalid path here
# would override a working PATH installation (server/.env is auto-loaded).
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# --- Admin API (管理后台) ---
# Bearer token protecting /admin/api. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the admin API entirely.
ADMIN_TOKEN=
# Run the in-process generation worker (default 1). Set 0 to disable (e.g. run a
# separate worker process instead).
# ADMIN_WORKER_ENABLED=1
